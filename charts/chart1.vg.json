
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
    "data": {
      "url": "https://mrltsyaa.github.io/Wings-across-Australia/data/birdlife.csv"
    },
  
    
"transform": [
    {
      "filter": "datum.Species !== 'Shorebird aggregation' && datum.Species !== 'Species diversity'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Records"
        }
      ],
      "groupby": ["Species"]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Records",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 10"
    }
  ],
  
    "mark":{
      "type": "bar",
      "color": "#59846C"
    },
  
    "encoding": {
      "x": {
        "field": "Records",
        "type": "quantitative",
        "title": "Number of Records"
      },
  
      "y": {
        "field": "Species",
        "type": "nominal",
        "sort": "-x",
        "title": "Bird Species"
      },

      "tooltip": [
        {
          "field": "Species",
          "type": "nominal"
        },
        {
          "field": "Records",
          "type": "quantitative",
          "title": "Number of Records"
        }
      ]
    },
  
    "width": 450,
    "height": 500,
    "config":{
        "axis": {
            "labelFont": "Arial",
            "titleFont": "Arial"
        },
        "legend":{
            "labelFont": "Arial",
            "titleFont": "Arial"
        }
    }
  }
  