
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "width": 550,
  "height": 420,
  "projection": {
    "type": "mercator",
    "center": [134, -25],
    "scale": 450,
    "translate": [275, 210]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E7EFE7",
        "stroke": "#829B8A",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/ramsar_site_points.csv"
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "Lat"
        },
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "Lon"
        },
        {
          "filter": "isValid(datum.Lat) && isValid(datum.Lon) && datum.Lat >= -45 && datum.Lat <= -9 && datum.Lon >= 112 && datum.Lon <= 155"
        },
        {
          "calculate": "floor(datum.Lon / 3) * 3",
          "as": "GridLon"
        },
        {
          "calculate": "floor(datum.Lat / 3) * 3",
          "as": "GridLat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "SiteCount"
            }
          ],
          "groupby": [
            "GridLon",
            "GridLat"
          ]
        },
        {
          "calculate": "datum.GridLon + 3",
          "as": "GridLonEnd"
        },
        {
          "calculate": "datum.GridLat + 3",
          "as": "GridLatEnd"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "GridLon",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "GridLonEnd"
        },
        "latitude": {
          "field": "GridLat",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "GridLatEnd"
        },
        "color": {
          "field": "SiteCount",
          "type": "quantitative",
          "title": "Ramsar sites",
          "scale": {
            "scheme":"blues"
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "SiteCount",
            "type": "quantitative",
            "title": "Number of Ramsar Sites"
          },
          {
            "field": "GridLon",
            "type": "quantitative",
            "title": "Grid Longitude"
          },
          {
            "field": "GridLat",
            "type": "quantitative",
            "title": "Grid Latitude"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#829B8A",
        "strokeWidth": 0.9
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
